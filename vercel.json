{
  "services": {
    "doctor-tracker-api": {
      "root": ".",
      "buildCommand": "npm ci --include=dev && npm run build",
      "entrypoint": "src/app.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "doctor-tracker-api"
      }
    }
  ]
}
